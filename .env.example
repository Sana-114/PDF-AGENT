# Application
APP_NAME=PaperPilot
APP_VERSION=0.2.0
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Persistence. docker-compose overrides these hostnames automatically.
DATABASE_URL=sqlite:///./data/pdfagent.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Host ports published by Docker Compose. Change these if Windows reserves 6333-6379.
REDIS_HOST_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
VECTOR_SEARCH_ENABLED=false
VECTOR_COLLECTION=paperpilot_chunks_v1
VECTOR_PREFETCH_K=24
VECTOR_TIMEOUT_SECONDS=3

# File handling
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PARSED_DIR=./data/parsed
TRANSLATION_DIR=./data/translations
MAX_UPLOAD_MB=200
MAX_CSV_MB=10

# Scholarly discovery. API keys are optional; remote PDFs are restricted to this host allowlist.
SCHOLARLY_API_TIMEOUT_SECONDS=20
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_API_BASE_URL=https://export.arxiv.org/api
CROSSREF_BASE_URL=https://api.crossref.org
SCHOLARLY_CONTACT_EMAIL=
SCHOLARLY_PDF_HOSTS=arxiv.org,export.arxiv.org,pdfs.semanticscholar.org
REFERENCE_DISCOVERY_CONCURRENCY=2
REFERENCE_MATCH_THRESHOLD=0.55
ARXIV_REFRESH_INTERVAL_MINUTES=360
ARXIV_REQUEST_DELAY_SECONDS=3
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
GITHUB_CODE_SEARCH_ENABLED=true
GITHUB_CODE_LOOKUP_LIMIT=3

# Tasks: true keeps local development usable without Redis.
CELERY_TASK_ALWAYS_EAGER=true
PARSE_BATCH_PAGES=25

# OCR. Tesseract language data is installed by the backend Docker image.
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=32
OCR_TESSDATA=

# Model and retrieval integrations
# DeepSeek example (keep the real key only in the ignored .env file):
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
RAG_MIN_SCORE=0.18
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-ngram-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=http://localhost:8002/v1
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=60
RERANKER_CANDIDATE_K=12
RERANKER_RETRIEVAL_WEIGHT=0.25

# MinIO (provisioned by docker-compose; local storage is used by the MVP API)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=pdfagent
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=pdfagent
