# Application
APP_NAME=PaperPilot
APP_VERSION=0.2.0
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Persistence. docker-compose overrides these hostnames automatically.
DATABASE_URL=sqlite:///./data/pdfagent.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# File handling
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PARSED_DIR=./data/parsed
MAX_UPLOAD_MB=200

# Tasks: true keeps local development usable without Redis.
CELERY_TASK_ALWAYS_EAGER=true

# Future model integrations
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
RAG_MIN_SCORE=0.18
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# MinIO (provisioned by docker-compose; local storage is used by the MVP API)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=pdfagent
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=pdfagent
