# Public address. PUBLIC_DOMAIN must not contain https:// or a path.
PUBLIC_DOMAIN=paper.example.com
FRONTEND_ORIGIN=https://paper.example.com
NEXT_PUBLIC_API_BASE_URL=https://paper.example.com/api/v1

# Shared reviewer gate at the HTTPS edge. Store the bcrypt hash in single quotes
# so Compose does not expand the dollar signs. Never commit the real hash.
DEMO_USERNAME=reviewer
DEMO_PASSWORD_HASH='CHANGE_ME_WITH_CADDY_BCRYPT_HASH'

# Use URL-safe random values. COMPOSE_DATABASE_URL must match the PostgreSQL fields.
POSTGRES_DB=pdfagent
POSTGRES_USER=pdfagent
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
COMPOSE_DATABASE_URL=postgresql+psycopg://pdfagent:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/pdfagent

MINIO_ROOT_USER=pdfagent-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MINIO_PASSWORD
MINIO_ACCESS_KEY=pdfagent-admin
MINIO_SECRET_KEY=CHANGE_ME_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=pdfagent

# DeepSeek is recommended for the public competition demo. Keep the key only in
# the server-side .env.production file and rotate any key previously shared.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=CHANGE_ME_NEW_DEEPSEEK_KEY
LLM_TIMEOUT_SECONDS=60

# Host ports below are irrelevant in production because docker-compose.prod.yml
# removes every direct service publication except Caddy 80/443.
FRONTEND_HOST_PORT=3000
REDIS_HOST_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

LOG_LEVEL=INFO
WEB_CONCURRENCY=1
MAX_UPLOAD_MB=200
MAX_CSV_MB=10
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng

# Optional scholarly integrations.
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
SCHOLARLY_CONTACT_EMAIL=
