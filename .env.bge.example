# Copy this file to .env.bge before enabling the optional local-bge profile.
# Public BAAI models do not require HF_TOKEN. Never commit a real token.
HF_TOKEN=

# Hugging Face Text Embeddings Inference runtime (CPU by default).
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_CPU_THREADS=8
TEI_MAX_CLIENT_BATCH_SIZE=32
BGE_EMBEDDING_PORT=8001
BGE_RERANKER_PORT=8002

# Models cached in named Docker volumes after the first download.
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Backend -> local TEI containers.
VECTOR_SEARCH_ENABLED=true
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://bge-embedding/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32

RERANKER_PROVIDER=tei
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=http://bge-reranker
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=120
RERANKER_CANDIDATE_K=12
RERANKER_RETRIEVAL_WEIGHT=0.25

# GPU override uses this image when docker-compose.bge-gpu.yml is included.
TEI_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cuda-1.9
